# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — never NEXT_PUBLIC_. Used for trusted writes (session results, skill map, vocabulary).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Show-and-tell deployments without Supabase/OpenAI: "Try the demo" with the scripted tutor.
# Ignored once Supabase keys are set. Demo data lives in server memory and can reset.
# DEMO_MODE=1

# Used to build auth redirect URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI (server only). Without it, development uses a scripted demo tutor.
OPENAI_API_KEY=
# Optional model / voice overrides (defaults shown)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_ASSESS_MODEL=gpt-5.5
# OPENAI_TRANSLATE_MODEL=gpt-5.4-mini
# OPENAI_VOICE_FEMALE=marin
# OPENAI_VOICE_MALE=cedar

# 3D tutor avatars (GLB). Folder or CDN holding giulia.glb, marco.glb, emma.glb, james.glb…
# e.g. /avatars for files in public/avatars (git-ignored). Unset = still portrait.
# NEXT_PUBLIC_AVATAR_BASE_URL=/avatars
# Below this frame rate the still portrait is used (0 disables the check, for testing).
# NEXT_PUBLIC_AVATAR_MIN_FPS=12
